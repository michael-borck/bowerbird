{
  "name": "bowerbird",
  "version": "0.1.0",
  "private": true,
  "description": "Finds and verifies supporting resources for your teaching.",
  "author": "Michael Borck",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/michael-borck/bowerbird.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:server": "npm run dev -w @michaelborck/bowerbird-server",
    "dev:web": "npm run dev -w @michaelborck/bowerbird-web"
  }
}
