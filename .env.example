# Bowerbird server configuration.
# Copy to .env next to docker-compose.yml and fill in; docker compose loads
# it automatically. Keep the real .env out of git and chmod 600 on servers.

# Port the container listens on (compose maps it to the host).
PORT=3000

# Redis for the BullMQ queue. The compose stack provides this service;
# only change it if you run Redis elsewhere.
REDIS_URL=redis://redis:6379

# Ollama instance the server uses for rationale generation.
# - Ollama on the VPS host itself: http://host.docker.internal:11434
#   (add `extra_hosts: ["host.docker.internal:host-gateway"]` on Linux)
# - Ollama as a compose service: http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434

# Bearer key sent as `Authorization: Bearer <key>` to the Ollama instance,
# for setups where Ollama sits behind an authenticating reverse proxy.
# Leave empty if your Ollama is reachable without auth (e.g. localhost only).
# Note: this is the server's own service credential. Users' BYO keys are a
# different thing and are never persisted server-side (ADR-0004).
OLLAMA_API_KEY=
